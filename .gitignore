.venv/
venv/
.env
__pycache__/
.python-version

# Roboflow datasets (unzip locally)
data/detection/
data/roi/
data/ocr/
data/identify/
data/input/*
!data/input/.gitkeep
!data/input/README.md

# Training artifacts (local GPU dumps)
runs/*
!runs/README.md

# Official Ultralytics downloads (not our trained models)
pretrained/*
!pretrained/README.md

# Production export weights in models/ are tracked; everything else stays out
*.pt
!models/*.pt
*.onnx
*.engine
wandb/

# Cropper image dumps
output/cropper/
src/cropper/output/
src/cropper/weights/*.pt

# Sweep reports: README + figures stay in git; PDFs are for the thesis
docs/experiments/**/report.pdf
train/**/report.pdf

Thumbs.db
Desktop.ini
.DS_Store
